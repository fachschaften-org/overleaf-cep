extends ../layout-website-redesign

block vars
	- isWebsiteRedesign = true

block content
	main#main-content.content
		.container
			.row
				.col-lg-6.offset-lg-3.col-xl-4.offset-xl-4
					.page-header
						if login_support_title
							h1 !{login_support_title}
						else
							h1 #{translate("log_in")} 

					.text-center
						p
							| Willkommen auf dem HajTeX von&nbsp;
							a(href="https://fachschaften.org ") Fachschaften.org!
						p
							| Hier kannst du kollaborativ an LaTeX-Dokumenten arbeiten.
							| Zur Nutzung brauchst du einen Fachschaften.org-Account.
					if settings.oidc && settings.oidc.enable
						.actions(style='margin-top: 30px;')
							.btn.btn-primary.mt-2(
								href='/oidc/login',
								style="width: 100%;"
								data-ol-disabled-inflight
							)
								span(data-ol-inflight="idle") #{settings.oidc.identityServiceName}
								span(hidden data-ol-inflight="pending") #{translate("logging_in")}…
